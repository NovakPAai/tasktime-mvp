DATABASE_URL=postgresql://tasktime:replace-with-staging-db-password@postgres:5432/tasktime_staging?schema=public
SOURCE_DATABASE_URL=postgresql://readonly-user:replace-with-readonly-password@prod-host:5432/tasktime?schema=public
# SOURCE_DATABASE_URL is required by db:sync:prod-to-dev and should point to a read-only production/staging source.
JWT_SECRET=replace-with-staging-jwt-secret
JWT_REFRESH_SECRET=replace-with-staging-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://staging.tasktime.local
REDIS_URL=redis://redis:6379
REDIS_CACHE_TTL_SECONDS=30
# Optional bootstrap. Enable explicitly when you really want built-in users.
BOOTSTRAP_DEFAULT_PASSWORD=
BOOTSTRAP_ENABLED=false
# Optional personal admin account created only during explicit bootstrap.
BOOTSTRAP_OWNER_ADMIN_EMAIL=
# MCP service token (Bearer token clients use to authenticate to the MCP HTTP server)
MCP_SERVICE_TOKEN=
# MCP agent account password (agent@flow-universe.internal — for write operations via backend API)
MCP_AGENT_PASSWORD=
# TTSRH-1 feature flags — deploy-staging.yml injects values on each deploy.
# Leave blank in the example; the workflow writes `=true` on staging.
FEATURES_ADVANCED_SEARCH=
FEATURES_CHECKPOINT_TTQL=

# TTBUS-0 event bus / transactional outbox relay.
NOTIFICATIONS_ENABLED=false
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=tasktime-backend
OUTBOX_RELAY_INTERVAL_MS=500
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_MAX_ATTEMPTS=10
OUTBOX_RELAY_TRANSACTION_TIMEOUT_MS=60000
OUTBOX_CLEANUP_RETENTION_DAYS=7
